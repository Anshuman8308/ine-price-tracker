{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "globals": {
    "document": "readonly",
    "window": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-empty": "warn"
  }
}